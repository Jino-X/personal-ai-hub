# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
# Public URL of this API (used in device pairing instructions and OAuth redirects)
PUBLIC_API_URL=http://localhost:8787
# Web app URL (CORS origin and OAuth return URL). Extra origins: CORS_ORIGINS=https://a,https://b
WEB_APP_URL=http://localhost:3000
# Set to true when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
# New-style keys (sb_publishable_… / sb_secret_…). Legacy anon/service_role JWT keys also work.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Only needed for projects still on the legacy HS256 JWT secret (asymmetric JWKS keys are verified automatically)
SUPABASE_JWT_SECRET=

# Optional: restrict the workspace to these emails (comma separated). Recommended for a personal deployment.
ALLOWED_EMAILS=

# ── Security ────────────────────────────────────────────────────────────────
# 32+ random characters — signs short-lived local AI device access tokens.  openssl rand -base64 48
DEVICE_TOKEN_SECRET=
# 32-byte base64 key — encrypts integration OAuth tokens at rest.         openssl rand -base64 32
ENCRYPTION_KEY=

# ── AI inference ────────────────────────────────────────────────────────────
# Default path: the local AI companion connects to this API over an authenticated WebSocket.
# Optional: when the API runs on the same machine as Ollama, it can call Ollama directly.
OLLAMA_DIRECT_URL=
# Optional OpenAI-compatible cloud provider (only used if a user enables it in Settings → AI)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CHAT_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=
AI_REQUEST_TIMEOUT_MS=180000

# ── Intelligence sources ────────────────────────────────────────────────────
# Optional tokens raise rate limits / enable sources
GITHUB_TOKEN=
HF_TOKEN=
PRODUCT_HUNT_TOKEN=

# ── Google Calendar (optional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Background processing ───────────────────────────────────────────────────
WORKER_ENABLED=true
SCHEDULER_ENABLED=true
WORKER_CONCURRENCY=2
