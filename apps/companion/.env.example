# Local Ollama endpoint (keep it on loopback)
HUB_COMPANION_OLLAMA_URL=http://127.0.0.1:11434
# Optional comma-separated allow-list of models jobs may use (empty = any installed model)
HUB_COMPANION_ALLOWED_MODELS=qwen3:8b,qwen3-embedding:0.6b
# Parallel inference jobs (match OLLAMA_NUM_PARALLEL)
HUB_COMPANION_MAX_CONCURRENT_JOBS=2
# Hard caps applied to every job regardless of what the server requests
HUB_COMPANION_MAX_CONTEXT_LENGTH=32768
HUB_COMPANION_MAX_OUTPUT_TOKENS=8192
HUB_COMPANION_LOG_LEVEL=INFO
